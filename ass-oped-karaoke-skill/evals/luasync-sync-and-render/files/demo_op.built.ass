Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ Name 欄位裡有沒有這個旗標（以空白分隔的獨立字詞） ]] function HASFLAG(actor, word) for t in actor:gmatch('%S+') do if t == word then return true end end return false end
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ 基本色與高亮色；高亮詞在歌詞裡用 inline fx \-hi 標出來，模板不看文字 ]] DEMO_BASE = '&HFFFFFF&' DEMO_HI = '&H66CCFF&'
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ 每個音節晚 30ms 進場，放大 120% 再回彈 ]] DEMO_STEP = 30 DEMO_POP = 120
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ 第 0 拍的絕對時間（ms，由 bpm.py 量出來）與每拍長度：落在拍點上的音節彈得大一點 NC 版平移時間軸時 DEMO_B0 要跟著平移，否則整首的重音會跑掉 ]] DEMO_B0 = 1000 DEMO_BT = 60000 / 150
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ 這個音節是不是落在拍點上（±60ms） ]] function demoOnBeat() local t = (line.start_time + syl.start_time - DEMO_B0) % DEMO_BT return t < 60 or t > DEMO_BT - 60 end
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ y：Name 欄位有 top 就取上下鏡像的位置（能推算的就不要手寫），否則照樣式的 MarginV ]] function demoY() if HASFLAG(line.actor, 'top') then return meta.res_y - line.middle end return line.middle end
Comment: 0,0:00:00.00,0:00:00.00,Default,,0,0,0,code once,--[[ 一個音節一行：淡入 ＋ 放大回彈；顏色由 inline fx 決定 ]] function demoSyl(blur) local c = (syl.inline_fx == 'hi') and DEMO_HI or DEMO_BASE local d = (syl.i - 1) * DEMO_STEP local pop = demoOnBeat() and (DEMO_POP + 15) or DEMO_POP return string.format( '{\\an5\\pos(%.1f,%.1f)\\1c%s\\3c%s\\blur%.1f\\fscx%d\\fscy%d\\t(%d,%d,\\fscx100\\fscy100)\\alpha&HFF&\\t(%d,%d,\\alpha&H00&)}', line.left + syl.center, demoY(), c, c, blur, pop, pop, d, d + 180, d, d + 120) end
